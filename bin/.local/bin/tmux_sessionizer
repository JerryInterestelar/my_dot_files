#!/usr/bin/env bash

# Função que gera a lista de projetos baseada na sua estrutura específica
DIR="$HOME/codes/"
get_projects() {
  # 1. Pastas "Pai": Onde cada subpasta é um projeto independente
  # Ex: javascript/lipsync, python/projetos/CRUD, my_dot_files/nvim
  find \
    $DIR/javascript \
    $DIR/python/projetos \
    $DIR/rust \
    -mindepth 1 -maxdepth 2 -type d 2>/dev/null
  # 2. Projetos "Soltos": Pastas que já são o projeto em si
  # Adicione aqui pastas específicas que não seguem o padrão acima
  echo "$DIR/python/mangacafe"
  echo "$DIR/python/scripts"
  echo "$DIR/shell"
}
if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(get_projects | fzf)
fi

if [[ -z $selected ]]; then
  exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# --- LÓGICA HÍBRIDA (TMUXP) ---
if [[ -f "$selected/.tmuxp.yaml" || -f "$selected/.tmuxp.yml" ]]; then
  export SESSION_NAME=$selected_name

  if [[ -n $TMUX ]]; then
    # DENTRO do tmux
    tmuxp load -d "$selected/.tmuxp.yaml" >/dev/null 2>&1
    tmux switch-client -t $selected_name
    exit 0
  else
    # FORA do tmux (Correção aplicada aqui)
    tmuxp load -d "$selected/.tmuxp.yaml" >/dev/null 2>&1
    tmux attach-session -t $selected_name
    exit 0
  fi
fi

# --- LÓGICA PADRÃO (SEM TMUXP) ---
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s $selected_name -c $selected
  exit 0
fi

if ! tmux has-session -t=$selected_name 2>/dev/null; then
  tmux new-session -ds $selected_name -c $selected
fi

if [[ -z $TMUX ]]; then
  tmux attach-session -t $selected_name
else
  tmux switch-client -t $selected_name
fi
